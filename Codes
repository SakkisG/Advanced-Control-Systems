# Remove everything above 200% from the mean value
def remove_outliers(df, column):
    mean = df[column].mean()
    upper_threshold = 3*mean
    lower_threshold = -1*mean
    return df[(df[column] >= lower_threshold) & (df[column] <= upper_threshold)]

