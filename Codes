def heatmap(df,title):
     # correlation heatmap για να δούμε τις συσχετίσεις μεταξύ των μεταβλητών
    wrapped_labels = [textwrap.fill(label.replace('_', ' '), width=1, break_long_words=False) for label in df.columns] # to wrap after each word
    plt.figure(figsize=(10,8))
    ax = sns.heatmap(df.corr(), annot=True, cmap="coolwarm", fmt=".2f", 
                     linewidths=0.5, linecolor='lightgray')
    plt.title(title)
    ax.set_xticklabels(wrapped_labels, rotation=0, ha='center', multialignment='center') # to wrap and rotate labels
    ax.set_yticklabels(wrapped_labels, rotation=0, ha='center', va='center', multialignment='center') # to wrap and rotate labels
    ax.tick_params(axis='y', which='major', pad=30) # add padding
    plt.tight_layout() # auto adjust layout
    targets=['NOx', 'lambda', 'Fuel Consumption', 'Intake Pressure']
    corr_matrix = df.corr()
    for target in targets: # to add a black box on the heatmap
        if target in corr_matrix.index:
            idx = list(corr_matrix.index).index(target)
            from matplotlib.patches import Rectangle
            ax.add_patch(Rectangle((0, idx), len(df.columns), 1, 
                                 fill=False, edgecolor='black', lw=3, clip_on=False))
    plot=plt.show()
    return plot

